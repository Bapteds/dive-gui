NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN="http://localhost:5173"
# Root directory for uploaded OpenFOAM case files (one subtree per project),
# resolved relative to the API working directory. Keep it out of version control.
STORAGE_DIR="./storage"
# Maximum size (MB) of a single uploaded case file. Raise for very large meshes.
MAX_UPLOAD_MB=1024
# --- CGNS -> OpenFOAM conversion toolchain --------------------------------------
# External binaries used by "Convert to Foam". These exist on the Debian deploy
# target; on a Windows dev box they may be absent, in which case each conversion
# step reports a clear "not found" instead of failing the request. Defaults
# assume the tools are on PATH (Linux).
#
# Python interpreter for the CGNS->VTK script. The script uses the standalone
# VTK wheel (`pip install vtk`), NOT paraview.simple — so use a plain `python3`,
# NOT `pvpython` (pvpython mixes ParaView's bundled VTK with the pip VTK in one
# process and segfaults / silently drops the file name).
CGNS_PYTHON_BIN="python3"
# Absolute path to the CGNS->VTK script. Empty => the script bundled
# with the API at apps/api/scripts/CgnsToVtk.py. Set only to override.
CGNS_TO_VTK_SCRIPT=""
# OpenFOAM mesh utilities (on PATH once the OpenFOAM environment is sourced).
VTK_TO_FOAM_BIN="vtkUnstructuredToFoam"
CHECK_MESH_BIN="checkMesh"
# autoPatch: splits external boundary faces into patches by feature angle
# ("Auto-patch boundaries" action). Same OpenFOAM environment as the tools above.
AUTO_PATCH_BIN="autoPatch"
# --- Multi-mesh merge ("Merge meshes" flow) ----------------------------------
# mergeMeshes combines several imported polyMesh sources into one; stitchMesh
# conformally fuses chosen patch pairs (e.g. inlet<->outlet) into internal
# interfaces. Same OpenFOAM environment as the tools above.
MERGE_MESHES_BIN="mergeMeshes"
STITCH_MESH_BIN="stitchMesh"
# stitchMesh face-matching tolerance, relative to local edge length (OpenFOAM v11+
# replaced -partial/-perfect with -tol). Empty = the tool's own default (1e-4);
# raise it for separately-built parts whose interface faces only approximately meet.
STITCH_TOL=""
# Assembly v2: OpenFOAM.org v12 NON-conformal coupling utility. Keeps both parts'
# cells + patches and adds a coupled nonConformalCyclic_on_* pair for the touching
# interface patches (flow interpolates, no node coincidence). Patch names are
# POSITIONAL: createNonConformalCouples -overwrite <a> <b> -case <master>.
NCC_COUPLE_BIN="createNonConformalCouples"
# Per-step wall-clock timeout (ms) for a merge command. Raise for big meshes.
MERGE_STEP_TIMEOUT_MS=600000
# Fluent/Ansys .msh -> polyMesh for the "Import mesh file" path. Use gmshToFoam
# instead if your .msh is a Gmsh mesh. FLUENT_TO_FOAM_SCALE adds "-scale <f>".
FLUENT_TO_FOAM_BIN="fluent3DMeshToFoam"
FLUENT_TO_FOAM_SCALE=""
# --- OpenFOAM -> CGNS export for CFD-Post ("Export" tab) ---
# Writing CGNS is ParaView-only (core VTK has a CGNS reader but NO writer), so the
# convert step runs under ParaView's pvbatch. foamDictionary/postProcess are
# OpenFOAM tools; the CGNS re-read for validation uses MESH_PYTHON_BIN + the vtk
# wheel (no ParaView needed to read). Empty script paths => the bundled scripts.
PVBATCH_BIN="pvbatch"
# paraview.simple segfaults on import without a GL context (ParaView w/o OSMesa).
# "true" (default) runs `xvfb-run -a pvbatch …` for a virtual X display — needs
# `apt install xvfb`. Set "false" only if pvbatch has working offscreen GL.
PVBATCH_XVFB="true"
# If a pip `vtk` wheel in site-packages crashes pvbatch on import (PyVTKObject
# SIGSEGV — a VTK version conflict with ParaView), set this to the directory
# holding ParaView's own VTK python (where `paraview/` + its `vtkmodules/` live,
# e.g. /usr/lib/python3/dist-packages) so it wins on PYTHONPATH. Empty = untouched.
PVBATCH_PYTHONPATH=""
FOAM_DICTIONARY_BIN="foamDictionary"
POST_PROCESS_BIN="postProcess"
FOAM_TO_CGNS_SCRIPT=""
CGNS_INSPECT_SCRIPT=""
# Export the WHOLE time series (one CGNS per solved time, zipped) vs only the
# latest time. ParaView can't pack a transient series into one file. Default
# "true" (time evolution); "false" = final result only.
EXPORT_ALL_TIMES="true"
# Optional path to an OpenFOAM etc/bashrc. When set, the OpenFOAM utilities run
# inside `bash -c 'source <bashrc> && exec "$@"'` so their environment is loaded.
# Leave empty when the tools are already on PATH. Pick the path for your install:
#   OpenFOAM.org (Debian):  OPENFOAM_BASHRC="/opt/openfoam12/etc/bashrc"
#   OpenFOAM.com (ESI):     OPENFOAM_BASHRC="/usr/lib/openfoam/openfoam2406/etc/bashrc"
OPENFOAM_BASHRC=""
# Per-step wall-clock timeout (ms) for a conversion command. Raise for big meshes.
CONVERSION_STEP_TIMEOUT_MS=600000
# --- 3D mesh viewer (Visualize tab) ------------------------------------------
# The viewer's geometry is extracted offline by a one-shot Python script
# (apps/api/scripts/extractPatches.py) into a compact GLB + manifest, cached on
# disk. Needs python3 + pyvista/trimesh/numpy (see scripts/requirements.txt).
MESH_PYTHON_BIN="python3"
# Absolute path to the boundary-patch extractor. Empty => the bundled
# apps/api/scripts/extractPatches.py (resolved relative to the module).
EXTRACT_PATCHES_SCRIPT=""
# Wall-clock timeout (ms) for a single mesh-extraction run. Raise for big meshes.
MESH_BUILD_TIMEOUT_MS=600000
# --- OpenFOAM solver run (Solver tab) ----------------------------------------
# Runs a solver (e.g. simpleFoam) on a project's prepared case. The solver binary
# lives on the Debian target (OpenFOAM env sourced via OPENFOAM_BASHRC above); on
# a Windows dev box it is absent, so a run reports "not found" instead of crashing.
# The actual solver is read from the case's controlDict `application`; this is a
# fallback default.
SOLVER_BIN="simpleFoam"
# Hard wall-clock cap for one run (ms). Default 6 h.
SOLVER_MAX_RUNTIME_MS=21600000
# Max concurrent runs per project (v1 = 1; a second start is rejected).
SOLVER_MAX_CONCURRENT_RUNS=1
# Cap (bytes) on a persisted solver.log (32 MB).
SOLVER_LOG_MAX_BYTES=33554432
# Grace (ms) after a graceful stop before escalating to SIGTERM/SIGKILL.
RUN_STOP_GRACE_MS=30000
# MPI launcher for the parallel path (decomposePar + mpirun -np N + reconstructPar).
MPI_BIN="mpirun"
# Flags passed to mpirun before `-np N`. The default makes the requested core count
# map to MPI slots (the usual "not enough slots" fix on a hyperthreaded host);
# override for a non-OpenMPI launcher.
MPI_RUN_FLAGS="--allow-run-as-root --use-hwthread-cpus --oversubscribe"
# Mesh decomposition method (system/decomposeParDict). `scotch` (default) needs the
# scotch library; set `hierarchical` or `simple` if it is absent (coeffs auto-generated).
DECOMPOSE_METHOD="scotch"
# Global core budget for parallel runs across ALL projects (0 = machine core count).
# A run is refused when active runs' cores + the request would exceed this.
SOLVER_TOTAL_CORES=0
# --- Project terminal (Terminal button) -------------------------------------
# A per-project interactive shell over WebSocket, scoped to the project directory.
# OFF by default: it runs a real shell as the API's OS user (a deliberate exception to
# the app's shell-free model), so enable it ONLY on a trusted, single-tenant box, and
# note any project collaborator would get a shell. When 'false' the endpoint refuses
# every upgrade and the web client hides the Terminal button.
TERMINAL_ENABLED="false"
# Shell to launch. Empty => bash -i (Linux/macOS) / powershell.exe (Windows).
TERMINAL_SHELL=""
# Idle timeout (ms) before an inactive terminal session is killed. Default 15 min.
TERMINAL_IDLE_TIMEOUT_MS=900000
# Max concurrent terminal sessions across the server. Default 20.
TERMINAL_MAX_SESSIONS=20
# Trusted reverse-proxy hops in front of the API. 0 = trust none (direct/local).
# Set to 1 when running behind a single proxy/load balancer so the login
# rate-limiter sees the real client IP. In production the JWT secrets above must
# be at least 32 chars, differ from each other, and not reuse these placeholders.
TRUST_PROXY=0
SEED_ADMIN_EMAIL="admin@dive-turbinen.de"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Super Admin"
