NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN="http://localhost:5173"
# Root directory for uploaded OpenFOAM case files (one subtree per project),
# resolved relative to the API working directory. Keep it out of version control.
STORAGE_DIR="./storage"
# Maximum size (MB) of a single uploaded case file. Raise for very large meshes.
MAX_UPLOAD_MB=1024
# --- CGNS -> OpenFOAM conversion toolchain --------------------------------------
# External binaries used by "Convert to Foam". These exist on the Debian deploy
# target; on a Windows dev box they may be absent, in which case each conversion
# step reports a clear "not found" instead of failing the request. Defaults
# assume the tools are on PATH (Linux).
#
# ParaView's python, used to run the CGNS->VTK script (Windows dev: pvpython.exe).
PVPYTHON_BIN="pvpython"
# Absolute path to the CGNS->VTK ParaView script. Empty => the script bundled
# with the API at apps/api/scripts/CgnsToVtk.py. Set only to override.
CGNS_TO_VTK_SCRIPT=""
# OpenFOAM mesh utilities (on PATH once the OpenFOAM environment is sourced).
VTK_TO_FOAM_BIN="vtkUnstructuredToFoam"
CHECK_MESH_BIN="checkMesh"
# autoPatch: splits external boundary faces into patches by feature angle
# ("Auto-patch boundaries" action). Same OpenFOAM environment as the tools above.
AUTO_PATCH_BIN="autoPatch"
# Optional path to an OpenFOAM etc/bashrc. When set, the OpenFOAM utilities run
# inside `bash -c 'source <bashrc> && exec "$@"'` so their environment is loaded.
# Leave empty when the tools are already on PATH. Pick the path for your install:
#   OpenFOAM.org (Debian):  OPENFOAM_BASHRC="/opt/openfoam12/etc/bashrc"
#   OpenFOAM.com (ESI):     OPENFOAM_BASHRC="/usr/lib/openfoam/openfoam2406/etc/bashrc"
OPENFOAM_BASHRC=""
# Per-step wall-clock timeout (ms) for a conversion command. Raise for big meshes.
CONVERSION_STEP_TIMEOUT_MS=600000
# --- 3D mesh viewer (Visualize tab) ------------------------------------------
# The viewer's geometry is extracted offline by a one-shot Python script
# (apps/api/scripts/extractPatches.py) into a compact GLB + manifest, cached on
# disk. Needs python3 + pyvista/trimesh/numpy (see scripts/requirements.txt).
MESH_PYTHON_BIN="python3"
# Absolute path to the boundary-patch extractor. Empty => the bundled
# apps/api/scripts/extractPatches.py (resolved relative to the module).
EXTRACT_PATCHES_SCRIPT=""
# Wall-clock timeout (ms) for a single mesh-extraction run. Raise for big meshes.
MESH_BUILD_TIMEOUT_MS=600000
# Trusted reverse-proxy hops in front of the API. 0 = trust none (direct/local).
# Set to 1 when running behind a single proxy/load balancer so the login
# rate-limiter sees the real client IP. In production the JWT secrets above must
# be at least 32 chars, differ from each other, and not reuse these placeholders.
TRUST_PROXY=0
SEED_ADMIN_EMAIL="admin@dive-turbinen.de"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Super Admin"
