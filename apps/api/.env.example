NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN="http://localhost:5173"
# Root directory for uploaded OpenFOAM case files (one subtree per project),
# resolved relative to the API working directory. Keep it out of version control.
STORAGE_DIR="./storage"
# Trusted reverse-proxy hops in front of the API. 0 = trust none (direct/local).
# Set to 1 when running behind a single proxy/load balancer so the login
# rate-limiter sees the real client IP. In production the JWT secrets above must
# be at least 32 chars, differ from each other, and not reuse these placeholders.
TRUST_PROXY=0
SEED_ADMIN_EMAIL="admin@dive-turbinen.de"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Super Admin"
