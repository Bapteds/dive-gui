# DIVE MCP server configuration.
# Copy to apps/mcp/.env and fill in a dedicated service account's credentials.
# The .env file is gitignored — never commit real credentials.

# Base URL of the DIVE API, INCLUDING the /api/v1 prefix.
#   - Deployed server (reverse proxy on port 80 serves the web app AND proxies
#     /api/v1 to the backend): use the host with no explicit port.
#       DIVE_API_URL="http://192.168.5.51/api/v1"
#   - Local API dev server (npm run dev): port 4000.
#       DIVE_API_URL="http://localhost:4000/api/v1"
DIVE_API_URL="http://192.168.5.51/api/v1"

# Service-account credentials. The MCP server logs in at startup and
# re-logs in automatically when the 15-minute access token expires (on any 401).
# Use a dedicated account, not a personal one; scope its role to what the tools need.
DIVE_MCP_EMAIL="mcp-service@dive.local"
DIVE_MCP_PASSWORD="change-me"

# Optional request timeout in milliseconds (default 60000) for ordinary calls.
DIVE_MCP_TIMEOUT_MS="60000"

# Optional longer timeout (default 600000 = 10 min) applied to known-slow tools:
# mesh merge, CGNS conversion, CFD-Post export, snappyHexMesh/cfMesh runs, and
# file up/downloads. Never falls below DIVE_MCP_TIMEOUT_MS.
DIVE_MCP_SLOW_TIMEOUT_MS="600000"

# Optional retry count (default 2) for transient failures — a dropped
# connection, a timeout, or a 502/503/504 from a restarting proxy. Retries apply
# ONLY to idempotent GETs and login; a POST/PUT/DELETE is never auto-retried, so
# a merge or a solver start can never fire twice. Set 0 to disable.
DIVE_MCP_RETRIES="2"
